# flyee.club platform — environment reference. Copy to .env (or .env.local,
# which wins over .env) and fill with the flyee.club projects' values.
#
# NEVER point these at another product's services: the db:*:remote scripts
# migrate whatever DATABASE_URL names.
#
# `npm run preflight` (repo root) reads the files the app reads and says, by
# name and never by value, what a stage still lacks: docs/DEPLOY.md, "Roteiro
# da abertura".

# Canonical site URL in production, no trailing slash (sitemap/robots/OG/JSON-LD
# fall back to http://localhost:3000 without it).
NEXT_PUBLIC_SITE_URL=
# Cookie/localStorage key prefix.
NEXT_PUBLIC_STORAGE_PREFIX="fc"

# --- Supabase (leave empty to browse without auth) ---
# Project URL and anon key: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Pooled connection string (port 6543) for @flyee/db and the
# remote migration gate (scripts/remote-db-gate.mjs). Percent-encode the
# special characters of the password: a $ is %24.
DATABASE_URL=
# Server-only. Service role key — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (optional; a currency whose provider has no key cannot be bought) ---
# Routed by the plan's currency: Asaas charges BRL, Stripe charges USD
# (docs/BILLING.md). BILLING_BRL_PROVIDER moves BRL: "stripe" sends reais to
# Stripe too (no card installments, Pix only if on in Stripe's dashboard, no
# NFS-e from the platform); empty or "asaas" keeps them on Asaas. Any other
# value takes BRL off sale.
BILLING_BRL_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# An Asaas key starts with a dollar sign. In a file Next.js reads, write it
# with a backslash (\$aact_...): a bare $name is expanded, to nothing when no
# variable has that name, quoted or not. In the Vercel settings it goes as is.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Default: Asaas sandbox. Production: https://api.asaas.com/v3
ASAAS_BASE_URL=
# Pix kill switch: "false" hides Pix. Empty = ask the Asaas account whether it
# has an active Pix key (docs/ASAAS-GO-LIVE.md).
BILLING_PIX_ENABLED=

# --- Ads & analytics (optional; empty = no tracker loads, banner stays hidden) ---
# Meta Pixel: Events Manager > Data sources > your dataset > "Pixel ID".
NEXT_PUBLIC_META_PIXEL_ID=
# GA4 Measurement ID (G-XXXXXXXXXX): GA Admin > Data streams > Web stream.
NEXT_PUBLIC_GA4_ID=
# Server-only. GA4 Measurement Protocol API secret (lib/ga4-mp.ts).
GA4_API_SECRET=
# Server-only. Meta Conversions API access token (lib/meta-capi.ts).
META_CAPI_TOKEN=
# Optional. Test-events code (Events Manager > Test events) to verify CAPI live.
META_CAPI_TEST_EVENT_CODE=

# --- AI (operator-only: /admin/insights; the club never spends AI on members) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Background jobs (optional; without keys, work falls back to inline) ---
# Local dev needs no keys: run "npx inngest-cli dev".
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Backups (@flyee/backup; needs DATABASE_URL + SUPABASE_SERVICE_ROLE_KEY) ---
# Days to keep backup runs and their archives before pruning (default 30).
BACKUP_RETENTION_DAYS=

# --- Transactional email (optional; callers fall back without it) ---
# Server-only. https://resend.com API key.
RESEND_API_KEY=
# Verified sender, e.g. "flyee.club <no-reply@flyee.club>"
EMAIL_FROM=
# Where the public contact form is delivered.
CONTACT_FORM_TO=

# --- Public forms (waitlist) ---
# Server-only secret that pseudonymizes the visitor's network (HMAC of the IP)
# for the waitlist's per-network sign-up window. Without it there is no window.
# Any long random string; changing it only resets the window.
PUBLIC_FORMS_IP_SALT=

# Largest module package the catalog upload accepts, in MB (docs/CLI-CONTRACT.md).
# Server-only. The product's CI sends apps with this token (/api/service/catalog/*,
# docs/CLI-CONTRACT.md section 10): the same value as its FLYEE_SERVICE_TOKEN
# secret on GitHub, 32 characters or more (openssl rand -hex 32). Empty keeps
# those routes closed.
FLYEE_SERVICE_TOKEN=
MODULE_UPLOAD_MAX_MB=20
